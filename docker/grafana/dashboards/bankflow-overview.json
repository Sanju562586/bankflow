      "id": 1,
      "title": "API Gateway Request Throughput",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"api-gateway\"}[1m]))",
          "legendFormat": "Requests/sec"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Payment Service P99 Latency (ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"payment-service\"}[1m])) by (le)) * 1000",
          "legendFormat": "P99 ms"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Kafka Txn Ingestion Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(spring_kafka_listener_seconds_count[1m]))",
          "legendFormat": "Events/sec"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "AI Fraud Flagged Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"fraud-detection-service\", status=\"200\"}[1m]))",
          "legendFormat": "Fraud Checks/sec"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Microservice Request Rates",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application)",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "JVM Memory Usage (Heap)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (application)",
          "legendFormat": "{{application}}"
        }
      ]
    }
